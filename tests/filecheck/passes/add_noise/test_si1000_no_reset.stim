# RUN: deltakit_compile deltakit-stim parse %s -O %t.mlir
# RUN: deltakit_compile compile-passes %t.mlir -t -p add-noise --pass-args '{ \
# RUN:      "noise_model": "{ \
# RUN:          name: SI1000NoResetNoiseConfig, \
# RUN:          p: 0.01 \
# RUN:      }" \
# RUN:  }' -O %t.2.mlir
# RUN: deltakit_compile deltakit-stim print %t.2.mlir -O %t.stim
# RUN: filecheck %s --input-file %t.stim

R 0 1 2 3
TICK

# CHECK:      R 0 1 2 3
# CHECK-NEXT: X_ERROR(0.02) 0 1 2 3
# CHECK-NEXT: TICK

X 0 3
TICK

# CHECK-NEXT: X 0 3
# CHECK-NEXT: DEPOLARIZE1(0.001) 0 3 1 2
# CHECK-NEXT: TICK

CZ 0 1
SQRT_X 2
TICK

# CHECK-NEXT: CZ 0 1
# CHECK-NEXT: DEPOLARIZE2(0.01) 0 1
# CHECK-NEXT: SQRT_X 2
# CHECK-NEXT: DEPOLARIZE1(0.001) 2 3
# CHECK-NEXT: TICK

X 2
M 0 1
TICK

# CHECK-NEXT: X 2
# CHECK-NEXT: DEPOLARIZE1(0.001) 2
# CHECK-NEXT: X_ERROR(0.0408163) 0 1
# CHECK-NEXT: M(0.01) 0 1
# CHECK-NEXT: DEPOLARIZE1(0.02) 2 3
# CHECK-NEXT: DEPOLARIZE1(0.001) 3
# CHECK-NEXT: TICK

R 2
TICK

# CHECK-NEXT:  R 2
# CHECK-NEXT:  X_ERROR(0.02) 2
# CHECK-NEXT:  DEPOLARIZE1(0.02) 0 1 3
# CHECK-NEXT:  DEPOLARIZE1(0.001) 0 1 3
# CHECK-NEXT:  TICK

M 2
TICK

# CHECK-NEXT: X_ERROR(0.0408163) 2
# CHECK-NEXT: M(0.01) 2
# CHECK-NEXT: DEPOLARIZE1(0.02) 0 1 3
# CHECK-NEXT: DEPOLARIZE1(0.001) 0 1 3
# CHECK-NEXT: TICK

MPP X1*Z2
TICK

# CHECK-NEXT: Z_ERROR(0.0408163) 1
# CHECK-NEXT: X_ERROR(0.0408163) 2
# CHECK-NEXT: MPP(0.01) X1*Z2
# CHECK-NEXT: DEPOLARIZE1(0.02) 0 3
# CHECK-NEXT: DEPOLARIZE1(0.001) 0 3
# CHECK-NEXT: TICK

MPP X1 Z2*Y0*Z3
TICK
# CHECK-NEXT: Z_ERROR(0.0408163) 1
# CHECK-NEXT: MPP(0.01) X1
# CHECK-NEXT: X_ERROR(0.0408163) 2 0 3
# CHECK-NEXT: MPP(0.01) Z2*Y0*Z3
# CHECK-NEXT: TICK

X 2
MPP X0*X1
TICK

# CHECK-NEXT: X 2
# CHECK-NEXT: DEPOLARIZE1(0.001) 2
# CHECK-NEXT: Z_ERROR(0.0408163) 0 1
# CHECK-NEXT: MPP(0.01) X0*X1
# CHECK-NEXT: DEPOLARIZE1(0.02) 2 3
# CHECK-NEXT: DEPOLARIZE1(0.001) 3
# CHECK-NEXT: TICK
